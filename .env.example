# ===== Database =====
POSTGRES_USER=pa_user
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=pa_db
DB_HOST=localhost
DB_PORT=5432

# ===== App =====
APP_ENV=development
SECRET_KEY=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TIMEZONE=Asia/Shanghai

# ===== Frontend =====
VITE_API_BASE=/api/v1
WEB_PORT=5173
API_PORT=8000

# ===== External AI (optional, leave empty for demo mode) =====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUEST_TIMEOUT=30
LLM_TOTAL_TIMEOUT=60
LLM_MAX_RETRIES=1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== Agent / MCP tool runtime =====
DUCKDUCKGO_MAX_RESULTS=5
AGENT_MAX_TOOL_ITERATIONS=3
AGENT_MAX_TOTAL_TOOL_CALLS=10
TOOL_RESULT_MAX_CHARS=4000
# Base URL of the self-hosted MCP tool service (same compose network).
MCP_TOOL_SERVER_BASE_URL=http://mcp-server:8090
# Auth token enforced by mcp-server on tools/list and tools/call.
MCP_AUTH_TOKEN=change_me_to_a_long_random_mcp_token
# Key used to encrypt user-provided tool-server tokens at rest (backend).
MCP_SERVER_TOKEN_ENCRYPT_KEY=change_me_to_a_32_byte_encrypt_key

# ===== File uploads =====
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
MAX_TEXT_CHARS=100000
MAX_IMAGE_PIXELS=20000000
